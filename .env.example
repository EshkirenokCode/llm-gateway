# The default demo needs no environment variables.
GATEWAY_PROVIDER=mock
GATEWAY_MODELS=demo-model
GATEWAY_HTTP_ADDR=:8080
GATEWAY_REQUEST_TIMEOUT=60s

# Live upstream: set provider=compatible, its API base URL (including /v1),
# model IDs, the upstream key if required, and tenant credentials.
# GATEWAY_UPSTREAM_URL=http://127.0.0.1:11434/v1
# GATEWAY_UPSTREAM_KEY=
# Generate a tenant key: openssl rand -hex 32
# GATEWAY_TENANTS='[{"name":"portfolio","key":"replace-with-a-generated-key","rpm":60,"concurrency":4}]'
# GATEWAY_METRICS_KEY=
