# Copy to .env and fill in. Never commit .env.

GATEWAY_HTTP_ADDR=:8080
GATEWAY_LOG_LEVEL=info
GATEWAY_READ_HEADER_TIMEOUT=10s
GATEWAY_SHUTDOWN_TIMEOUT=15s

# Leave DATABASE_URL empty to run without tenants, accounting or budgets.
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
GATEWAY_DB_MAX_CONNS=10
GATEWAY_MIGRATE_ON_START=true

# Overrides the built-in price list.
GATEWAY_PRICING_FILE=

# How long a key verdict and a tenant spend total are reused. The key ttl also
# bounds how long a revoked key keeps working.
GATEWAY_KEY_CACHE_TTL=30s
GATEWAY_BUDGET_CACHE_TTL=15s
GATEWAY_IDEMPOTENCY_TTL=24h
GATEWAY_RATE_LIMIT_BURST_RATIO=0.25

# Provider credentials, used from phase 3 onwards.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
