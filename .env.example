# Copy to .env and fill in. Never commit .env.
GATEWAY_HTTP_ADDR=:8080
GATEWAY_LOG_LEVEL=info

# Provider credentials (leave empty to keep the provider disabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Postgres (used from phase 2 onwards)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
